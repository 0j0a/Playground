---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteContent } from '../data/site';
---

<BaseLayout title="Projects | Joa Visscher" currentPage="projects">
  <main class="retro-page-main"><div class="retro-page-intro"><p class="eyebrow">03 / project archive</p><h1>Work in<br /><em>progress.</em></h1><p>Samples, pattern studies, and constructed pieces. Each project stays close to the decisions that shaped it.</p></div><div class="project-grid-page">{siteContent.projects.map((project) => <article class="project-terminal"><p class="eyebrow">{project.number} / {project.type}</p><h2>{project.title}</h2><p>{project.description}</p><p class="mono">{project.year}</p></article>)}</div></main>
</BaseLayout>
