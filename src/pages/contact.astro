---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteContent } from '../data/site';
---

<BaseLayout title="Contact | Joa Visscher" currentPage="contact">
  <main class="retro-page-main"><div class="retro-page-intro"><p class="eyebrow">04 / open loop</p><h1>Let’s talk<br /><em>about making.</em></h1><p>For conversations about textiles, making, styling, or a project in progress.</p></div><div class="contact-grid-page"><div class="retro-copy"><p class="eyebrow">Find me here</p><p>Questions, collaborations, and thoughtful feedback are welcome. Send a note and I’ll get back to you.</p></div><div class="contact-details"><div class="contact-detail"><p class="mono">Email</p><a href={`mailto:${siteContent.contact.email}`}>{siteContent.contact.email}</a></div><div class="contact-detail"><p class="mono">Instagram</p><a href={siteContent.contact.instagramUrl} rel="noreferrer">{siteContent.contact.instagramHandle} ↗</a></div></div></div></main>
</BaseLayout>
