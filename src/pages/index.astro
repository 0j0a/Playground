---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteContent } from '../data/site';
---

<BaseLayout title="Joa Visscher | Process journal" currentPage="home">
  <section class="hero section-grid">
    <div class="hero-column hero-column-main">
      <p class="eyebrow">{siteContent.hero.eyebrow}</p>
      <h1>Making by hand.<br /><em>Learning by doing.</em></h1>
      <p class="hero-intro">{siteContent.hero.intro}</p>
      <div class="hero-wide-meta">
        <div><p class="hero-index mono">01 / PROFILE</p><p class="hero-column-text">A process journal for samples, experiments, construction problems, and finished pieces.</p></div>
        <div><p class="hero-index mono">02 / CURRENT FOCUS</p><p class="hero-column-text">{siteContent.signal}</p></div>
        <div class="stamp" aria-hidden="true">FIBER<br />+<br />FORM</div>
      </div>
      <p class="hero-kicker mono"><span class="status-dot"></span> Process journal in progress</p>
    </div>


<nav class="hero-nav-panel" aria-label="Main navigation">
  <p class="hero-index mono">NAVIGATION</p>
  <div class="hero-nav-grid">
    {siteContent.nav.map((item) => (
      <a href={item.href} aria-current={item.href === '/' ? 'page' : undefined}>
        {item.label}
      </a>
    ))}
    <a href="#work">View work</a>
  </div>
</nav>

  </section>

  <section class="signal-band" aria-label="Current focus"><div class="signal-label mono">Current signal</div><p>{siteContent.signal}</p><div class="signal-mark mono">04 / 04</div></section>

  <section class="work-section section-grid" id="work">
    <div class="section-heading"><p class="eyebrow">01 / current projects</p><h2>Things made<br /><em>in stages.</em></h2></div>
    <div class="project-list">{siteContent.projects.map((project) => <article class="project-row"><div class="project-number mono">{project.number}</div><div class="project-main"><p class="project-type mono">{project.type}</p><h3>{project.title}</h3><p>{project.description}</p></div><div class="project-meta"><span class="mono">{project.year}</span><a href={project.link} aria-label={`Open ${project.title}`}>↗</a></div></article>)}</div>
  </section>

  <section class="notes-section section-grid" id="notes">
    <div class="section-heading"><p class="eyebrow">02 / journal updates</p><h2>Small steps,<br /><em>kept visible.</em></h2></div>
    <div class="notes-content"><div class="notes-intro"><p>Making is easier to understand when the middle is not hidden. These are short updates from the workbench: what I tested, what changed, and what I want to try next.</p><a class="text-link" href={`mailto:${siteContent.contact.email}?subject=Join the notes`}>Join the occasional note <span aria-hidden="true">↗</span></a></div><div class="article-list">{siteContent.articles.map((article) => <article class="article-row"><div class="article-meta mono"><span>{article.date}</span><span>{article.readTime}</span></div><div><h3>{article.title}</h3><p>{article.excerpt}</p></div><span class="article-arrow" aria-hidden="true">↗</span></article>)}</div></div>
  </section>

  <section class="contact-section section-grid" id="contact"><p class="eyebrow">03 / open loop</p><div class="contact-copy"><h2>Want to see<br /><em>what comes next?</em></h2><a class="contact-link" href={`mailto:${siteContent.contact.email}`}>{siteContent.contact.email} <span aria-hidden="true">↗</span></a></div><p class="contact-note">For conversations about textiles, making, styling, or a project in progress.</p>
  </section>
</BaseLayout>
