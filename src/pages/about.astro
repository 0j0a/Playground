---
import BaseLayout from '../layouts/BaseLayout.astro';
import { siteContent } from '../data/site';
---

<BaseLayout title="About | Joa Visscher" currentPage="about">
  <main class="retro-page-main">
    <div class="retro-page-intro"><p class="eyebrow">01 / about</p><h1>A person behind<br /><em>the stitches.</em></h1><p>{siteContent.about.bio}</p></div>
    <div class="about-grid"><figure class="image-terminal image-tall"><div class="image-label mono">IMG_001 / WORKTABLE</div><img src="https://images.unsplash.com/photo-1558618666-fcd25c85cd64?auto=format&fit=crop&w=1000&q=80" alt="Textile materials and tools arranged on a worktable" /><figcaption class="mono">Tools / material / starting point</figcaption></figure><div class="retro-copy"><p class="eyebrow">What I’m learning</p><p>{siteContent.about.learningIntro}</p><p>{siteContent.about.journalNote}</p><div class="page-list">{siteContent.about.learningItems.map((item) => <div class="page-list-item"><h3>{item.title}</h3><p>{item.description}</p></div>)}</div></div></div>
  </main>
</BaseLayout>
