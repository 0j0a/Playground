---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { siteContent } from '../../data/site';
import { marked } from 'marked';

export function getStaticPaths() {
  return siteContent.articles.map((article) => ({
    params: { slug: article.slug },
    props: { article },
  }));
}

const { article } = Astro.props;
const bodyHtml = marked.parse(article.body) as string;
---

<BaseLayout title={`${article.title} | Joa Visscher`} description={article.excerpt} currentPage="journal">
  <main class="retro-page-main">
    <div class="retro-page-intro blog-post-intro">
        <p class="eyebrow">{article.date} / {article.category} / {article.readTime}

        </p>
         <h1>{article.title}</h1>
        <p>{article.excerpt}</p>
        <a class="retro-back-link" href="/journal">← Back to journal</a>
    </div>
    <div class="blog-post-layout"><div>
        <p class="eyebrow">Process note</p>
    </div>
    <div class="blog-post-copy" set:html={bodyHtml}>
    </div>
    </div>
  </main>
</BaseLayout>
