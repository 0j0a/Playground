---
import '../../styles.css';
import { siteContent } from '../data/site';

interface Props {
  title: string;
  description?: string;
  currentPage?: string;
}

const {
  title,
  description = 'The process journal of Joa Visscher, a fashion and textile technology student.',
  currentPage = '',
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=Manrope:wght@400;500;600;700;800&family=Silkscreen:wght@400;700&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet" />
  </head>
  <body class={currentPage === 'home' ? 'retro-home' : 'retro-page'}>
    <header class="site-header">
      <a class="wordmark" href="/" aria-label="Home">JV<span>/</span>FT</a>
      <div class="header-title mono">TEXTILE PROCESS JOURNAL / 2026</div>
      <div class="header-status mono">SYSTEM ONLINE</div>
    </header>
   {currentPage !== 'home' && (
  <nav class="page-nav" aria-label="Main navigation">
    {siteContent.nav.map((item) => {
      const isCurrent = item.href === '/' ? currentPage === 'home' : item.href === `/${currentPage}`;
      return (
        <a href={item.href} aria-current={isCurrent ? 'page' : undefined}>
          {item.label}
        </a>
      );
    })}
  </nav>
)}
    <main>
      <slot />
    </main>
    <footer class="site-footer">
      <span>© 2026 Joa Visscher</span>
      <span class="mono">Built by thinking together</span>
      <a href="/">Back to top ↑</a>
    </footer>
  </body>
</html>
